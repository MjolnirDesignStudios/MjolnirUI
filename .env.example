# ════════════════════════════════════════════════════════════════════
# MjolnirUI — Environment Variable Template
# ════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your own values.
#
#   cp .env.example .env.local
#
# NEVER commit .env.local — it contains real secrets. The .gitignore
# excludes it but allows this template through.
#
# All variables listed below are REQUIRED in production unless marked
# as "OPTIONAL" in the inline comment.
# ════════════════════════════════════════════════════════════════════


# ─── NextAuth ────────────────────────────────────────────────────────
# NEXTAUTH_URL: full canonical URL of this deployment (no trailing slash)
#   dev:   http://localhost:3000
#   prod:  https://mjolnirui.com
NEXTAUTH_URL=http://localhost:3000

# NEXTAUTH_SECRET: cryptographic secret used to sign JWTs.
#   Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=


# ─── Google OAuth ────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── GitHub OAuth ────────────────────────────────────────────────────
# Console: https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ─── Twitter OAuth (OPTIONAL — provider currently commented out in
#     nextAuthOptions.ts; populate only if you re-enable it) ──────────
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=


# ─── Supabase ────────────────────────────────────────────────────────
# Console: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=
# Service-role key — server-only. Used by webhook + admin routes. NEVER
# expose to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=


# ─── Stripe ──────────────────────────────────────────────────────────
# Console: https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ for development; sk_live_/pk_live_ for prod.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret (whsec_...). Get from your webhook endpoint config:
#   https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Product IDs — used by the pricing page to map tiers to Stripe products.
# Price IDs themselves are stored in app/lib/tierConfig.ts.
STRIPE_PRODUCT_BASE=prod_...
STRIPE_PRODUCT_PRO=prod_...
STRIPE_PRODUCT_ELITE=prod_...


# ─── Resend (transactional email) ────────────────────────────────────
# Console: https://resend.com/api-keys
# OPTIONAL: omit to disable welcome / receipt emails — the rest of the
# app continues to function.
RESEND_API_KEY=


# ─── HubSpot CRM (OPTIONAL) ──────────────────────────────────────────
# OPTIONAL until launch: leave blank to skip contact sync. Console:
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=


# ─── Meshy 3D (OPTIONAL — for the future 3D Forge tool) ──────────────
# Console: https://meshy.ai/
MESHY_API_KEY=
